*.bio
*.FLC
*.flc

# ── Sintergic harness internals (local process, registries, telemetry) ──
.sintergic/*
!.sintergic/registries/
# .sintergic/artifacts/: raw lane output kept locally as evidence, never versioned
.sintergic/artifacts/
# .sintergic/telemetry/ y .sintergic/sync-journal/ ignorados: volumen de máquina (WUD-117 P1)
.omp/
.omp-di/
.omp-fw/
.opencode/
sessions/
transcripts/
*.session.jsonl

# ── Local environment / tooling ──
.venv/
venv/
__pycache__/
*.pyc
.env
.env.*
!.env.example

# ── Config del harness atada a ESTA máquina (CR-8b1e4c22) ──
# Owner-absolute paths in `mcp.*.command` are not portable.
# Config NEUTRA de proyecto NO se ignora; esta fija bins locales → fuera del repo.
opencode.json

# ── Build artifacts ──
target/

# ── Editor / OS noise ──
.idea/
.vscode/
*.swp
.DS_Store
*.log
*.tmp

# ── Retired retail capture (never ships): 1996 .IMG/.CIF panel render ──
**/m18-demo-20261021/m17-ui-fixed.png

# ── Derived audio evidence (B1-b): retail-derived WAV, reproducible at run
# time by `cargo run --features window`; the `.json` footprint + sha256 line
# stays versionable, the binary never is (INV-L99-6, m-6).
docs/sintergic/l5-mission/m18-owner-gate/evidence/audio/*.wav

# ── Runtime save written while playing; never versioned ──
saves/
